# Copie para .env (não committado) e ajuste os valores para o seu MySQL
# local. Com `docker compose up`, as variáveis já vêm do docker-compose.yaml
# — este arquivo é só para rodar `python app.py` direto na sua máquina,
# contra um MySQL já em pé (local ou em container).

SECRET_KEY=troque-esta-chave

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hospital_rio_grande
MYSQL_USER=chamados
MYSQL_PASSWORD=chamados

FLASK_DEBUG=1
DADOS_DEMO=1

HOTELARIA_USUARIO=admin
HOTELARIA_SENHA=12345
ENFERMAGEM_USUARIO=enfermagem
ENFERMAGEM_SENHA=12345
